# 大模型（OpenAI 兼容接口）。qwen 可用 vLLM / DashScope 兼容模式，deepseek 可用官方 API。
HUIXIAOAN_LLM_PROVIDER=qwen
HUIXIAOAN_LLM_BASE_URL=http://127.0.0.1:8001/v1
HUIXIAOAN_LLM_MODEL=Qwen2.5-14B-Instruct
HUIXIAOAN_LLM_API_KEY=EMPTY

# 生成模型不可用时可设为 offline，使用抽取式兜底，保证链路可演示。
# HUIXIAOAN_LLM_PROVIDER=offline

# DeepSeek 官方接口示例：
# HUIXIAOAN_LLM_BASE_URL=https://api.deepseek.com/v1
# HUIXIAOAN_LLM_MODEL=deepseek-chat
# HUIXIAOAN_LLM_API_KEY=sk-xxx

# Embedding：bge-m3（生产）/ hashing（离线自测，无需下载模型）
HUIXIAOAN_EMBEDDING_PROVIDER=hashing
HUIXIAOAN_EMBEDDING_MODEL=BAAI/bge-m3

# 向量库：local（默认，文件持久化）/ milvus（生产）
HUIXIAOAN_VECTOR_BACKEND=local
HUIXIAOAN_MILVUS_URI=http://127.0.0.1:19530

# Redis 为空时自动降级为进程内缓存
HUIXIAOAN_REDIS_URL=

# 可选 API Key；设置后所有 /v1 接口需携带 X-API-Key
HUIXIAOAN_API_KEY=

# 可选：MySQL DSN（不配置则使用 data/audit 下的 SQLite）
# HUIXIAOAN_AUDIT_DB=mysql://huixiaoan:huixiaoan_pass@127.0.0.1:3306/huixiaoan
# HUIXIAOAN_MEMORY_DB=mysql://huixiaoan:huixiaoan_pass@127.0.0.1:3306/huixiaoan
# HUIXIAOAN_FAQ_DB=mysql://huixiaoan:huixiaoan_pass@127.0.0.1:3306/huixiaoan
# HUIXIAOAN_AUTH_DB=mysql://huixiaoan:huixiaoan_pass@127.0.0.1:3306/huixiaoan

# 登录 Token 签名密钥。生产多实例必须配置相同值；留空会自动生成到 auth.db 旁。
HUIXIAOAN_TOKEN_SECRET=

# 压测时可临时调高；生产按容量规划配置
HUIXIAOAN_RATE_LIMIT_QPS=20

# 用户上传图片识别：Qwen-VL/其他 OpenAI 兼容视觉模型
HUIXIAOAN_VISION_PROVIDER=offline
HUIXIAOAN_VISION_BASE_URL=
HUIXIAOAN_VISION_MODEL=qwen-vl-max
HUIXIAOAN_VISION_API_KEY=
